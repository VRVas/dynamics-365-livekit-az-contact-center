# Orchestrator API (FastAPI) image for Azure Container Apps.
# Distinct from the hosted-agent Dockerfile (which runs `python main.py`); this runs the
# ui_v2-facing FastAPI proxy on port 8000 via uvicorn.
FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt .
# All prerelease versions are pinned exactly, so a plain install resolves them deterministically
# (an exact `==<prerelease>` pin installs the prerelease without needing --pre, which would also
# pull prerelease transitive deps).
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
