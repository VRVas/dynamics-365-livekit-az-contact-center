# Copy to .env for local use. Never commit credentials.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-5.4-mini
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
ORCHESTRATOR_TARGET=local
GENAI_REASONING_EFFORT=low
GENAI_SERVICE_TIER=priority

# Stage validated deployment.json, system_prompt.md, knowledge.md and optional profiles.json
# beside app.py. Feature flags in deployment.json are authoritative; defaults enable no modules.
# CRM/knowledge use the existing Assist backend; agentAssist separately enables transcript ingestion.
ASSIST_BASE_URL=
ASSIST_INGEST_KEY=
ASSIST_ENABLED=true
ACS_EMAIL_CONNECTION_STRING=
ACS_EMAIL_SENDER=
