# Copy to .env for local development. Never commit real credentials.
# Use the complete server-side Authorization value documented by HUMAIN:
# the Bearer scheme followed by the client key and secret joined by a colon.
# Set false to deploy the service before credentials arrive. Calls are refused,
# and /health explicitly reports awaiting_humain_credentials.
HUMAIN_ENABLED=false
HUMAIN_AUTHORIZATION=
HUMAIN_TOKEN_ENDPOINT=https://livekit-admin.sanad.ink/api/tokens/client
HUMAIN_VOICE=mul_nourah
HUMAIN_ASR_MODEL=bayan_playground
HUMAIN_LLM_PROVIDER=allam
# Accepted pair: off keeps LiveKit interruption active with fast VAD.
HUMAIN_INTERRUPTION_POLICY_MODE=off
HUMAIN_TURN_TAKING_STRATEGY=fast_vad

# Requested email correspondence.
ACS_EMAIL_CONNECTION_STRING=
ACS_EMAIL_SENDER=

# Shared knowledge, Dynamics cases and existing transcript ingestion.
AGENT_ASSIST_BASE_URL=
AGENT_ASSIST_API_KEY=
AGENT_ASSIST_ENABLED=true

# Optional: browser voice works without ACS. Configure these for phone calls.
ACS_CONNECTION_STRING=
ACS_SOURCE_NUMBER=
ACS_CALLBACK_PATH=
ACS_MEDIA_STREAMING_WEBSOCKET_PATH=
ACS_AUTO_CONFERENCE_ENABLED=false
ACS_AUTO_CONFERENCE_NUMBER=
AGENT_PHONE_NUMBER=

# Native Dynamics outbound control; independent of the direct ACS /call endpoint.
# Keep submissions disabled until the native AI-led voice engagement is configured.
# Use a dedicated random key of at least 32 characters; server-side callers only.
DYNAMICS_ORG_URL=
DYNAMICS_OUTBOUND_CONFIG_ID=
DYNAMICS_OUTBOUND_API_KEY=
DYNAMICS_OUTBOUND_ENABLED=false

# Authenticated call-metadata observer; choose an expiry or explicit permanent mode.
DYNAMICS_NATIVE_PROBE_RESOURCE_ID=
DYNAMICS_NATIVE_PROBE_API_KEY=
DYNAMICS_NATIVE_PROBE_EXPIRES_AT=
DYNAMICS_NATIVE_PROBE_PERMANENT=false

# Bounded direct-media pilot. Copilot must retain the original native conversation.
# Use a separate API key and the Dynamics-owned ACS connection string, not the bot's.
DYNAMICS_NATIVE_MEDIA_ENABLED=false
DYNAMICS_NATIVE_MEDIA_TRANSPORT=callautomation
DYNAMICS_NATIVE_MEDIA_FAST_START=false
DYNAMICS_NATIVE_MEDIA_WORKSTREAM_ID=
DYNAMICS_NATIVE_MEDIA_ADDITIONAL_WORKSTREAM_IDS=
DYNAMICS_NATIVE_MEDIA_API_KEY=
DYNAMICS_NATIVE_MEDIA_ACS_CONNECTION_STRING=

# Required for customer/operator transcripts after human handover.
AZURE_COGNITIVE_SERVICES_ENDPOINT=
ACS_TRANSCRIPTION_WEBSOCKET_PATH=
