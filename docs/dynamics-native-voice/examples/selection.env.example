# Non-secret selections. Replace every placeholder before using.
# Save a private copy outside the repository; do not source this example unchanged.
ENV="native-voice"
TENANT_ID="<Dynamics-tenant-UUID>"
SUBSCRIPTION_ID="<same-tenant-Azure-subscription-UUID>"
ORG_URL="https://<organization>.crm<number>.dynamics.com"
APP_RG="rg-native-voice"
NATIVE_RG="rg-native-voice-telephony"
NATIVE_ACS_NAME="<dedicated-native-ACS-name>"
SYSTEM_TOPIC="eg-native-voice"

# Fill after the relevant deployment/UI phase. These are not interchangeable.
VOICE_ORIGIN="https://<voice-app>.azurecontainerapps.io"
VOICE_APP_NAME="<deployed-voice-Container-App-name>"
UAMI_CLIENT_ID="<application-UAMI-client-ID>"
UAMI_PRINCIPAL_ID="<application-UAMI-principal-ID>"
NATIVE_APP_USER_ID="<Dataverse-native-reader-application-user-ID>"
CRM_UAMI_CLIENT_ID="<separate-CRM-UAMI-client-ID>"
CRM_UAMI_PRINCIPAL_ID="<separate-CRM-UAMI-principal-ID>"
CRM_UAMI_RESOURCE_ID="/subscriptions/<subscription-UUID>/resourceGroups/<app-group>/providers/Microsoft.ManagedIdentity/userAssignedIdentities/<CRM-identity-name>"
EVENTGRID_APP_ID="<Event-Grid-delivery-app-client-ID>"
NATIVE_ACS_ID="/subscriptions/<subscription-UUID>/resourceGroups/<native-group>/providers/Microsoft.Communication/communicationServices/<native-ACS-name>"
BOT_ID="<Copilot-bot-UUID>"
WORKSTREAM_ID="<inbound-voice-workstream-UUID>"
QUEUE_ID="<native-voice-queue-UUID>"
BUSINESS_UNIT_ID="<business-unit-UUID-holding-native-records>"
REPRESENTATIVE_ID="<Dataverse-human-user-UUID>"
APP_NUMBER="<owned-application-ACS-number-in-E.164>"
DYNAMICS_NUMBER="<native-Dynamics-number-in-E.164>"
TEST_CALLER="<allowed-test-caller-in-E.164>"

# Never put API keys, connection strings, tokens or topic backups in this example.
